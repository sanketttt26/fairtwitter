{
  "manifest_version": 3,
  "name": "FairTwitter",
  "version": "1.0.0",
  "description": "Judge posts by content, not popularity: hides engagement counts and blurs who posted and when.",
  "content_scripts": [
    {
      "matches": ["https://*.x.com/*", "https://*.twitter.com/*"],
      "css": ["fair.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "fairtwitter@example.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
